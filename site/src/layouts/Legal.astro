---
import Base from "./Base.astro";
import type { Copy } from "../data/copy";

interface Props {
  copy: Copy;
  title: string;
  description: string;
  path: string;
  altPath: string;
  altLang: "en" | "fr";
}

const { copy, title, description, path, altPath, altLang } = Astro.props;
const home = copy.lang === "fr" ? "/fr/" : "/";
---

<Base copy={copy} title={`${title} — Spark`} description={description} path={path} altPath={altPath} altLang={altLang}>
  <article class="wrap legal">
    <a class="legal__back" href={home}>{copy.lang === "fr" ? "← Retour" : "← Back"}</a>
    <h1>{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-top: clamp(52px, 7vw, 88px);
    padding-bottom: clamp(72px, 10vw, 120px);
  }

  .legal h1,
  .legal .prose {
    max-width: 760px;
  }

  .legal .prose {
    margin-top: 30px;
  }

  .legal__back {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--dim);
    margin-bottom: 28px;
  }

  .legal__back:hover {
    color: var(--fg);
  }

  .legal h1 {
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    margin-bottom: 14px;
  }

</style>
