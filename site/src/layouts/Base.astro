---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import type { Copy } from "../data/copy";

interface Props {
  copy: Copy;
  title: string;
  description: string;
  /** Chemin canonique de la page courante. */
  path: string;
  /** Chemin de la même page dans l'autre langue. */
  altPath: string;
  altLang: "en" | "fr";
}

const { copy, title, description, path, altPath, altLang } = Astro.props;
const site = Astro.site ?? new URL("https://sparkawe.vercel.app");
const canonical = new URL(path, site);
const alternate = new URL(altPath, site);
const ogImage = new URL("/og.png", site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Spark",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS",
  softwareVersion: "0.1.0",
  license: "https://opensource.org/licenses/MIT",
  description,
  url: canonical.href,
  author: {
    "@type": "Person",
    name: "nnnnnzo",
    url: "https://github.com/nnnnnzo",
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang={copy.htmlLang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang} href={alternate} />
    <link rel="alternate" hreflang={copy.htmlLang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site)} />
    <meta name="theme-color" content="#090a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/montserrat-300.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Spark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={copy.htmlLang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={copy.htmlLang === "fr" ? "en_US" : "fr_FR"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{copy.lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>
    <Nav copy={copy} />
    <main id="main">
      <slot />
    </main>
    <Footer copy={copy} />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const links = document.querySelector<HTMLElement>("[data-menu]");
      toggle?.addEventListener("click", () => {
        const open = links?.getAttribute("data-open") === "true";
        links?.setAttribute("data-open", open ? "false" : "true");
        toggle.setAttribute("aria-expanded", open ? "false" : "true");
      });
      links?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) {
          links.setAttribute("data-open", "false");
          toggle?.setAttribute("aria-expanded", "false");
        }
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 10px 16px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.85rem;
  }

  .skip:focus {
    left: 12px;
    top: 12px;
  }
</style>
