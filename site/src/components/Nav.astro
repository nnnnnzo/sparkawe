---
import Logo from "./Logo.astro";
import type { Copy } from "../data/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const home = copy.lang === "fr" ? "/fr/" : "/";
const links = [
  { label: copy.nav.product, href: `${home}#product` },
  { label: copy.nav.agents, href: `${home}#agents` },
  { label: copy.nav.interaction, href: `${home}#interaction` },
  { label: copy.nav.extensions, href: `${home}#extensions` },
  { label: copy.nav.status, href: `${home}#status` },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <Logo href={home} />

    <button
      class="nav__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="nav-links"
    >
      {copy.nav.menu}
    </button>

    <nav class="nav__links" id="nav-links" data-menu aria-label="Sections">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a class="nav__lang" href={copy.switchHref} hreflang={copy.lang === "fr" ? "en" : "fr"}>
        {copy.switchCode}
      </a>
      <a
        class="btn btn--ghost btn--small nav__github"
        href="https://github.com/nnnnnzo/sparkawe"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path
            d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        <span>{copy.nav.github}</span>
      </a>
      <a class="btn btn--primary btn--small" href={`${home}#start`}>{copy.nav.download}</a>
    </div>
  </div>
</header>

<style>
  .nav__lang {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding: 6px 4px;
  }

  .nav__lang:hover {
    color: var(--fg);
  }
</style>
