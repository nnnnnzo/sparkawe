---
import { Image } from "astro:assets";
import AgentMark from "./AgentMark.astro";
import workspace from "../assets/screens/workspace.png";
import { AGENTS } from "../data/agents";
import { TILE_MARKS } from "../data/tiles";
import type { Copy } from "../data/copy";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const home = copy.lang === "fr" ? "/fr/" : "/";
const config = `{
  "mcpServers": {
    "spark": {
      "command": "/Applications/Spark.app/Contents/MacOS/spark-mcp"
    }
  }
}`;
---

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{copy.hero.eyebrow}</p>
    <div class="hero__top">
      <h1>
        {
          copy.hero.title.map((line, index) => (
            <span class:list={["line", { accent: index === copy.hero.accent }]}>{line}</span>
          ))
        }
      </h1>
    </div>

    <div class="hero__foot">
      <div class="hero__spec">
        <div class="spectrum" aria-hidden="true" style="max-width: 152px">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <p class="hero__meta">
          {copy.hero.meta.map((item) => <span>{item}</span>)}
        </p>
      </div>
      <div class="hero__aside">
        <p class="lede">{copy.hero.lede}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#start">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 20h16"></path>
            </svg>
            {copy.hero.primary}
          </a>
          <a class="btn btn--ghost" href="https://github.com/nnnnnzo/sparkawe" rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            {copy.hero.secondary}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <figure class="shot">
      <div class="shot__frame">
        <Image
          src={workspace}
          alt={copy.hero.shotAlt}
          widths={[760, 1140, 1520, 1890]}
          sizes="(max-width: 1236px) 100vw, 1180px"
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </figure>
  </div>
</section>

<section class="section" id="awe">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.awe.eyebrow}</p>
        <h2>{copy.awe.title}</h2>
      </div>
      <p class="lede">{copy.awe.lede}</p>
    </div>
    <div class="grid grid--3">
      {
        copy.awe.cards.map((card) => (
          <article>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="product">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.product.eyebrow}</p>
        <h2>{copy.product.title}</h2>
      </div>
      <p class="lede">{copy.product.lede}</p>
    </div>
    <div class="grid grid--3">
      {
        copy.product.cards.map((card, index) => {
          const mark = TILE_MARKS[index];
          return (
            <article>
              <div class="card__head">
                <svg
                  class="card__icon"
                  style={`color: var(--${mark.color})`}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={mark.icon}
                />
                <span class="card__index">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section class="section" id="agents">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.agents.eyebrow}</p>
        <h2>{copy.agents.title}</h2>
      </div>
      <p class="lede">{copy.agents.lede}</p>
    </div>

    <div class="agents" style="margin-bottom: 18px">
      {
        AGENTS.map((agent) => (
          <div class="agent">
            <AgentMark agent={agent} />
            <div>
              <span class="agent__name">{agent.name}</span>
              <span class:list={["agent__tag", { "agent__tag--auto": agent.setup }]}>
                {agent.setup ? copy.agents.auto : copy.agents.manual}
              </span>
            </div>
          </div>
        ))
      }
    </div>
    <p class="foot-note">{copy.agents.note}</p>

    <div class="agents__how">
      <div>
        <h3 class="block-title">{copy.agents.howTitle}</h3>
        <p class="block-lede">{copy.agents.howLede}</p>
        <div class="steps">
          {
            copy.agents.steps.map((step) => (
              <div class="step">
                <span class="step__n" aria-hidden="true" />
                <div>
                  <strong class="step__title">{step.title}</strong>
                  <p>{step.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <aside class="agents__side">
        <div class="panel">
          <h4>{copy.agents.configTitle}</h4>
          <pre class="code" aria-label="JSON">{config}</pre>
          <p>{copy.agents.configNote}</p>
        </div>
        <div class="panel">
          <h4>{copy.agents.limitsTitle}</h4>
          <ul class="limits">
            {copy.agents.limits.map((limit) => <li>{limit}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="section" id="interaction">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.interaction.eyebrow}</p>
        <h2>{copy.interaction.title}</h2>
      </div>
      <p class="lede">{copy.interaction.lede}</p>
    </div>

    <div class="gestures">
      {
        copy.interaction.gestures.map((gesture) => (
          <div class="gesture">
            <span class="gesture__keys">{gesture.keys}</span>
            <strong>{gesture.title}</strong>
            <span>{gesture.body}</span>
          </div>
        ))
      }
    </div>

    <p class="foot-note">{copy.interaction.agentLink}</p>
  </div>
</section>

<section class="section" id="extensions">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.extensions.eyebrow}</p>
        <h2>{copy.extensions.title}</h2>
      </div>
      <p class="lede">{copy.extensions.lede}</p>
    </div>

    <div class="grid grid--3" style="margin-bottom: 22px">
      {
        copy.extensions.cards.map((card, index) => (
          <article>
            <span class="card__index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>

    <div class="notice" role="note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3.5 2.8 19.5h18.4L12 3.5Z"></path>
        <path d="M12 9.5v4.2"></path>
        <path d="M12 16.9v.2"></path>
      </svg>
      <div>
        <h3>{copy.extensions.noticeTitle}</h3>
        <p>{copy.extensions.notice}</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="status">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.status.eyebrow}</p>
        <h2>{copy.status.title}</h2>
      </div>
      <p class="lede">{copy.status.lede}</p>
    </div>

    <dl class="status">
      {
        copy.status.rows.map((row) => (
          <div class="status__row">
            <dt>{row.label}</dt>
            <dd set:html={row.value} />
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="section" id="start">
  <div class="wrap">
    <div class="section__head">
      <div>
        <p class="eyebrow">{copy.start.eyebrow}</p>
        <h2>{copy.start.title}</h2>
      </div>
      <p class="lede">{copy.start.lede}</p>
    </div>

    <div class="start">
      <ol class="start__steps">
        {
          copy.start.steps.map((step) => (
            <li>
              <span class="start__label">{step.label}</span>
              <pre class="code">{step.command}</pre>
            </li>
          ))
        }
      </ol>

      <aside class="start__side">
        <div class="protocol">
          <div>
            <span class="protocol__k">{copy.start.git}</span>
            <a
              class="protocol__v mono"
              href="https://github.com/nnnnnzo/sparkawe"
              rel="noreferrer">github.com/nnnnnzo/sparkawe</a
            >
          </div>
          <div>
            <span class="protocol__k">{copy.start.license}</span>
            <a class="protocol__v mono" href={copy.footer.legalLinks[0].href}>MIT</a>
          </div>
        </div>
        <p>{copy.start.note}</p>
        <a class="btn btn--ghost" href="https://github.com/nnnnnzo/sparkawe/issues" rel="noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M4 5h16M4 12h16M4 19h9"></path>
          </svg>
          Issues
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  h1 .line {
    display: block;
  }

  h1 .accent {
    color: var(--cyan);
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .card__icon {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .card__head .card__index {
    margin-bottom: 0;
  }

  .foot-note {
    margin-top: 18px;
    font-size: 0.86rem;
    color: var(--dim);
    max-width: 80ch;
  }

  .block-title {
    font-size: 1.35rem;
    margin-bottom: 10px;
  }

  .block-lede {
    color: var(--muted);
    font-size: 0.94rem;
    max-width: 64ch;
    margin-bottom: 26px;
  }

  .agents__how {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.85fr);
    gap: clamp(24px, 5vw, 72px);
    margin-top: clamp(44px, 6vw, 72px);
  }

  .agents__side {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .panel h4 {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    margin: 0 0 12px;
  }

  .panel p {
    color: var(--dim);
    font-size: 0.82rem;
    margin-top: 10px;
    line-height: 1.55;
  }

  .step__title {
    font-weight: 300;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .limits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .limits li {
    position: relative;
    padding-left: 18px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .limits li::before {
    content: "×";
    position: absolute;
    left: 0;
    top: -1px;
    color: var(--coral);
    font-family: var(--mono);
    font-size: 0.8rem;
  }

  .gesture__keys {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--cyan);
  }

  .start {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.85fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .start__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    counter-reset: start;
  }

  .start__steps li {
    counter-increment: start;
  }

  .start__label {
    display: flex;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--dim);
    margin-bottom: 9px;
  }

  .start__label::before {
    content: counter(start) ".";
    color: var(--cyan);
  }

  .start__side {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .start__side .btn {
    justify-self: start;
  }

  .start__side p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .protocol {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .protocol > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
  }

  .protocol > div + div {
    border-top: 1px solid var(--line-soft);
  }

  .protocol__k {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .protocol__v {
    font-size: 0.78rem;
    color: var(--fg);
    text-align: right;
    word-break: break-all;
  }

  @media (max-width: 980px) {
    .agents__how,
    .start {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
