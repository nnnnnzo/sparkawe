{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark",
  "version": "0.1.0",
  "identifier": "fr.spark.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "beforeBuildCommand": "npm run build && npm run sidecar:release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spark",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 27
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost https://api.openalex.org; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/pdf/**",
          "$APPCACHE/openalex/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/spark-mcp"
    ],
    "resources": {
      "src/terminal/zsh/vendor/COPYING.md": "licenses/zsh-syntax-highlighting.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
